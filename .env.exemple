# Copie ce fichier en `.env` et remplis ce qui te concerne.
#
#   cp .env.exemple .env
#   $EDITOR .env
#   npm start                 # ou : npm run agent -- expliquer-un-code --cas=gc-01-module-court
#
# `.env` est ignoré par git ET refusé par test/secrets.test.js s'il y entrait quand même.
# Ce fichier-ci est suivi : il ne contient aucune valeur, seulement les noms.
#
# Ne colle jamais une clé ailleurs qu'ici — ni dans un artefact, ni dans un message, ni
# dans un ticket. Une clé qui a été écrite quelque part de partagé est compromise, même
# effacée ensuite.

# ── DeepSeek — une clé, rien d'autre ──────────────────────────────────────────
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE=https://api.deepseek.com     # à changer derrière une passerelle interne

# ── Vertex AI ─────────────────────────────────────────────────────────────────
# VERTEX_PROJECT=
# VERTEX_LOCATION=europe-west9               # Paris. Défaut : europe-west1
# GOOGLE_APPLICATION_CREDENTIALS=./cle.json  # le chemin d'un fichier de clé
# GOOGLE_SERVICE_ACCOUNT_JSON=               # ou la clé elle-même, en JSON sur une ligne

# ── Réglages communs ──────────────────────────────────────────────────────────
# SALSI_FOURNISSEUR=deepseek                 # pour trancher soi-même : vertex | deepseek
# SALSI_MODELE_MID=                          # forcer un modèle sur un palier
